" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Do incremental searching.
set incsearch

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins

" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'

" --- Keymaps

" Leader key
let mapleader=" "

"  Disable the spacebar key's default behavior in Normal and Visual modes
nnoremap <Space> <Nop>
vnoremap <Space> <Nop>

"  delete single character without copying into register
nnoremap x "_x

"  Vertical scroll and center
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

"  Find and center
nnoremap n nzzzv
nnoremap N Nzzzv

"  Tabs
nnoremap <leader>to <Action>(NewTab)
nnoremap <leader>tx <Action>(CloseActiveTab)
nnoremap <leader>tn <Action>(NextTab)
nnoremap <leader>tp <Action>(PreviousTab)

"  Toggle line wrapping
nnoremap <leader>lw :set wrap!<CR>

"  Stay in indent mode
vnoremap < <gv
vnoremap > >gv

"  Keep last yanked when pasting
vnoremap p "_dP

" Previous / next error
nnoremap [d <Action>(GotoPreviousError)
nnoremap ]d <Action>(GotoNextError)

" Show error description
nnoremap <leader>d <Action>(ShowErrorDescription)

" Problems / diagnostics tool window
nnoremap <leader>q <Action>(ActivateProblemsView)

" Yank to clipboard
nnoremap <leader>y "+y
vnoremap <leader>y "+y

" Paste from clipboard
nnoremap <leader>p "+p
nnoremap <leader>P "+P
